# MCC Dashboard — Environment Configuration
# Copy this file to .env and fill in your values.
# This is the PC-local template. For Linux/CT103 deploys, use the nonsecret
# contract in deploy/mcc-ct103.env.example at /etc/mcc/mav-console.env instead.
# The PC SEO_APP_URL below intentionally remains localhost.

# Server
PORT=3000

# SEO Agents App (mav-bridge process — HTTP server on port 8790)
# This replaces the deprecated MAV_REPO_BRIDGE_URL
SEO_APP_URL=http://127.0.0.1:8790

# OpenAI
OPENAI_API_KEY=

# NVIDIA NIM
NVIDIA_NIM_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# RAG server (LAN)
MAV_RAG_URL=http://192.168.1.12:8181

# Prometheus
PROMETHEUS_URL=http://192.168.1.12:9090

# Local llama.cpp server
LLAMA_SERVER_URL=http://127.0.0.1:8080
LOCAL_MODEL=qwen3.6-35b

# Pi RPC
PI_EXECUTABLE=pi
PI_MODEL=qwen3.6-35b

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Workspace
MAV_CONSOLE_WORKSPACE=
MAV_CONSOLE_DATA_DIR=
MAV_MEMORY_PATH=
MAV_SKILLS_PATH=
MAV_EXTRA_ROOTS=

# HCP (Grizzly-HCP repo for estimate pipeline)
HCP_PROJECT_DIR=

# Thumbtack webhook intake (custom X-Maverick-Webhook-Token header)
THUMBTACK_WEBHOOK_SECRET=

# Brave Search (optional)
BRAVE_SEARCH_API_KEY=

# OpenAI Realtime (must be a real OpenAI key, not LiteLLM proxy key)
OPENAI_REALTIME_KEY=

# Venice (Pro+ eval 2026-07 → primary for open-weight cloud traffic)
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=zai-org-glm-5-2
VENICE_VISION_MODEL=z-ai-glm-5v-turbo
VENICE_QC_MODEL=llama-3.3-70b
VENICE_LOCAL_FALLBACK_MODEL=qwen3-6-27b
