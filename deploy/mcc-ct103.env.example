# CT103 mav-console deploy-time environment template.
# Intended destination: /etc/mcc/mav-console.env (mode 0600, owned by the
# CT103 service account). It is not /opt/mcc/.env. This tracked template holds
# no secrets; populate real secret values only through the deploy-time secret
# mechanism on CT103.

# Required at deploy: safe runtime topology.
PORT=3000
MAV_CONSOLE_WORKSPACE=/opt/mcc
MAV_RAG_URL=http://192.168.1.12:8181
PROMETHEUS_URL=http://192.168.1.12:9090
OPENAI_BASE_URL=http://192.168.1.12:4000

# Optional PC-backed SEO bridge. If enabled on CT103, use the PC through
# Tailscale; never point this Linux service at 127.0.0.1:8790.
SEO_APP_URL=http://100.124.216.11:8790

# Provider contract: configure at least one supported provider required by the
# enabled MCC features. Do not treat every key below as required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_NIM_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
VENICE_API_KEY=
OPENROUTER_API_KEY=

# Optional integrations and overrides. Leave blank when the feature is not
# enabled; source defaults apply where a corresponding default exists.
OPENAI_REALTIME_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
THUMBTACK_WEBHOOK_SECRET=
BRAVE_SEARCH_API_KEY=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
MAV_CONSOLE_DATA_DIR=
MAV_MEMORY_PATH=
MAV_SKILLS_PATH=
BRAIN_VAULT_PATH=
MAV_EXTRA_ROOTS=

# Deliberately unset on CT103: these are PC-only capabilities. Do not add
# KEY= lines for them unless a separately approved CT103 design replaces the
# PC dependency.
# LOCAL_MODEL_URL
# HCP_PROJECT_DIR
# GBP_PHOTOS_FOLDER
# GBP_PHOTOS_LOCAL_CACHE
# PI_EXECUTABLE
# PI_MODEL
